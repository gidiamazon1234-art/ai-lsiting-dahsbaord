# ---------------------------------------------------------------------------
# ClipForge environment variables
# Copy to .env.local for local development. Only NEXT_PUBLIC_* values are
# exposed to the browser; everything else stays on the server.
# ---------------------------------------------------------------------------

# Public URL of the app (no trailing slash). Used for Stripe redirects and
# fal.ai webhooks. On Vercel you can omit it and VERCEL_URL is used instead,
# but setting your real domain is recommended.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Bypasses row level security - never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# fal.ai -> https://fal.ai/dashboard/keys (server only)
FAL_KEY=your-fal-key

# Anthropic (prompt enhancer) -> https://console.anthropic.com/settings/keys (server only)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe -> Developers -> API keys / Webhooks (server only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
